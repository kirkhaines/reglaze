{
    "$schema":  "../_schema.json",
    "app_id":  "brave",
    "name":  "Brave Browser",
    "website":  "https://brave.com/",
    "install":  {
                    "method":  "winget",
                    "scope":  "machine",
                    "winget_id":  "Brave.Brave",
                    "steam_id":  null,
                    "download_url":  null,
                    "default_target_directory":  null,
                    "guide_file":  null,
                    "post_install_script":  null,
                    "instructions":  []
                },
    "directories":  [
                        {
                            "id":  "local_extension_settings",
                            "description":  "Brave extension local configurations, userscripts, and rules (chrome.storage.local)",
                            "default_path":  "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\Default\\Local Extension Settings",
                            "category":  "configs",
                            "needs_mapping":  false,
                            "safe_for_stream":  false,
                            "recommended_storage":  "sync",
                            "notes":  "Preserves complex extension configurations (uBlock custom rules, Tampermonkey userscripts, Stylus styles). Uses LevelDB key-value stores; requires local sync rather than streaming."
                        },
                        {
                            "id":  "sync_extension_settings",
                            "description":  "Brave extension synced storage state (chrome.storage.sync)",
                            "default_path":  "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\Default\\Sync Extension Settings",
                            "category":  "configs",
                            "needs_mapping":  false,
                            "safe_for_stream":  false,
                            "recommended_storage":  "sync",
                            "notes":  "Small LevelDB storage for synced extension settings. Optional; Brave Sync Chain does not sync local extension state."
                        }
                    ]
}
