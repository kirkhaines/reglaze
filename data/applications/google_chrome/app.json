{
    "$schema":  "../_schema.json",
    "app_id":  "google_chrome",
    "name":  "Google Chrome",
    "website":  "https://www.google.com/chrome/",
    "install":  {
                    "method":  "winget",
                    "winget_id":  "Google.Chrome",
                    "steam_id":  null,
                    "download_url":  null,
                    "default_target_directory":  null,
                    "guide_file":  null,
                    "post_install_script":  null,
                    "instructions":  []
                },
    "directories":  [
                        {
                            "id":  "local_extension_settings",
                            "description":  "Chrome extension local configurations, userscripts, and rules (chrome.storage.local)",
                            "default_path":  "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\Default\\Local Extension Settings",
                            "category":  "configs",
                            "needs_mapping":  false,
                            "safe_for_stream":  false,
                            "recommended_storage":  "sync",
                            "notes":  "Preserves complex extension configurations (uBlock filters, Tampermonkey userscripts, Stylus styles) that exceed Chrome Sync's 100 KB quota. Uses LevelDB key-value stores; requires local sync rather than streaming."
                        },
                        {
                            "id":  "sync_extension_settings",
                            "description":  "Chrome extension synced storage state (chrome.storage.sync)",
                            "default_path":  "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\Default\\Sync Extension Settings",
                            "category":  "configs",
                            "needs_mapping":  false,
                            "safe_for_stream":  false,
                            "recommended_storage":  "sync",
                            "notes":  "Small LevelDB storage for synced extension settings. Optional; native Google Account sync also covers extensions."
                        }
                    ]
}
